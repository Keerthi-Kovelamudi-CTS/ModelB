# V3 lung pipeline configuration — loaded by config.py (python-dotenv).
# These are NON-secret hyperparameters; override per-run via real env vars (env wins over .env).

# --- GCP / data ---
GCP_PROJECT=prj-cts-ai-dev-sp
HORIZONS=12mo,1mo
FE_YEARS_BEFORE=5            # feature-engineering lookback window (years)
FE_WINDOWS=5,10,20,100      # lookback windows the runner loops over (yrs; 100=lifetime)
SCORING_YEARS_BEFORE=5      # Phase-1 code-scoring lookback window (years)

# --- Phase 1b: codelist construction (build_codelist.py) ---
TOP_N=500                   # # of top data-driven codes by combined_rank
OR_MIN=2.0                  # eligibility: risk-increasing odds-ratio floor
PREV_MIN=0.01               # eligibility: >= this fraction of cancer patients
MIN_VALUE_FRAC=0.30         # a code is "value-bearing" if >= this fraction of its events are numeric
USE_CURATED=1               # 1 = force-include curated_codes.json + give them concept FE; 0 = data-driven only

# --- Phase 2b: stability selection (stability_select.py) ---
N_FOLDS=5
MIN_FOLDS=3                 # keep a feature if in the cumimp set in >= this many folds
CUM_IMP=0.99                # per-fold cumulative-importance cutoff

# --- Phase 2: feature engineering (build_features.py) ---
FE_ENGINE=pandas            # pandas (default) | polars (accelerated; use only after fe_parity_check.py passes)
ANCHOR_MODE=patient_last    # patient_last | cohort_anchor
TREND_MAX_MONTHS=none       # none = full window; or an int (months) to cap trends
DECAY_TAU_MONTHS=12.0
LAB_Z_EXTREME=2.0

# --- Phase 3: modeling (lung_training.py) ---
RANDOM_STATE=42
TEST_SIZE=0.10
CALIB_SIZE=0.10
DROP_THRESHOLD=0.90
TUNE=0                      # 1 = enable Optuna tuning (slow, top-5)
TUNE_TOP_N=5
N_TUNING_TRIALS=100
TUNING_CV_FOLDS=5

# --- Phase 4: held-out evaluation (evaluate_heldout.py) ---
HELDOUT_CHUNK=0             # 0 = whole-batch; N>0 = patient-chunked (OOM-safe for wide codelists)

# --- canonical split (split-first; created once by make_split.py, loaded by every step) ---
# Shared GCS location so the split is identical for everyone, every run, forever.
SPLIT_DIR=gs://gcs-ai-dev-model-artifacts/keerthi/Lung_Cancer/splits
USE_SAVED_SPLIT=1          # 1 = load the saved canonical split everywhere (split-first)
# Common GCS root for shared artifacts (feature parquets, models) — optional, used by the runner.
GCS_ROOT=gs://gcs-ai-dev-model-artifacts/keerthi/Lung_Cancer
